# Innovise - Apache settings (copied into dist/ by Vite on build).
# Ignored by servers that are not Apache.

# ---------- Compression ----------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# ---------- Caching ----------
<IfModule mod_headers.c>
  # Vite gives files in /assets/ a content hash in the name, so they can be cached for a year
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Fonts change rarely
  <FilesMatch "\.(woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  # Unhashed images in the site root (favicon, logos)
  <FilesMatch "\.(png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML must always be re-checked so new deploys show up
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---------- SPA routing ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Serve real files and folders (robots.txt, sitemap.xml, prerendered pages) as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Everything else goes to the React app
  RewriteRule ^ index.html [L]
</IfModule>
